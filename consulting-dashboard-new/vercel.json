{
  "buildCommand": "npx prisma generate && npm run db:generate && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production",
    "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING": "1",
    "PRISMA_CLI_QUERY_ENGINE_TYPE": "binary",
    "PRISMA_SKIP_POSTINSTALL_GENERATE": "true"
  },
  "build": {
    "env": {
      "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING": "1",
      "PRISMA_CLI_QUERY_ENGINE_TYPE": "binary",
      "PRISMA_SKIP_POSTINSTALL_GENERATE": "true"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=0, stale-while-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dashboard",
      "destination": "/dashboard/executive",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/Client",
      "destination": "/dashboard/client"
    },
    {
      "source": "/dashboard/Executive", 
      "destination": "/dashboard/executive"
    },
    {
      "source": "/dashboard/PM",
      "destination": "/dashboard/pm"
    },
    {
      "source": "/dashboard/Consultant",
      "destination": "/dashboard/consultant"
    }
  ]
}